# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MOODLE_URL: The base URL of your Moodle Cloud instance (e.g., https://yourdomain.moodlecloud.com)
MOODLE_URL=https://your-moodle-instance.moodlecloud.com

# MOODLE_TOKEN: The Web Service token generated in Moodle
MOODLE_TOKEN=your_moodle_webservice_token
